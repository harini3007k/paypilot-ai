# =============================================================================
# PayPilot AI — .gitignore
# Keeps secrets, generated files, virtual environments and caches out of Git.
# =============================================================================

# --- Environment & Secrets ---
# NEVER commit API keys, credentials or access tokens.
.env
.env.*
*.env
secrets.json
credentials.json
config.secret.*

# --- SQLite Databases ---
# The database is auto-generated at runtime from synthetic data.
# If it ever contains real user or payment data, it must NEVER be committed.
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# --- Python Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/

# --- Python Cache & Compiled Files ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# --- Pytest & Coverage ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# --- Jupyter Notebooks (not used here, but safe to include) ---
.ipynb_checkpoints/
*.ipynb

# --- OS-generated Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- VS Code ---
# Keep .vscode/settings.json if your team shares editor config,
# but exclude user-specific files.
.vscode/launch.json
.vscode/tasks.json

# --- Distribution / Build ---
dist/
build/
*.egg-info/
*.egg
